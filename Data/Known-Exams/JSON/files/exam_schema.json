    "year": {
      "type": "integer"
    },
    "exam_index": {
      "type": "integer",
      "minimum": 1
    },
    "age": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
