{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stat350-exam-record",
  "title": "STAT 350 Exam 1 annotated record",
  "description": "One file per exam. tags are topic ids from taxonomy.yaml. FRQ block tags/subskills are the union of their parts. 'age' is exams before the most recent (0 = newest) and drives the decay weight.",
